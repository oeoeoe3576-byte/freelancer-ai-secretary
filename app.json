{
  "expo": {
    "name": "프리랜서 AI 비서",
    "slug": "freelancer-ai-secretary",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.choiveler.freelancersecretary",
      "infoPlist": {
        "NSCameraUsageDescription": "일정을 사진으로 등록하려면 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "사진 속 글자를 인식해 일정으로 등록하려면 사진 보관함 접근 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.choiveler.freelancersecretary"
    },
    "web": {
      "name": "프리랜서 AI 비서",
      "shortName": "AI비서",
      "lang": "ko",
      "themeColor": "#22262F",
      "backgroundColor": "#FAF7F5",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "사진 속 글자를 인식해 일정으로 등록하려면 사진 보관함 접근 권한이 필요합니다.",
          "cameraPermission": "일정을 사진으로 등록하려면 카메라 접근 권한이 필요합니다."
        }
      ]
    ]
  }
}
